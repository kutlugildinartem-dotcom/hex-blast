<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- С Android 9 можно рисовать под вырезом камеры: так сверху не остаётся чёрной полосы. -->
    <style name="HexTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/hex_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
